{
	"name": "ygo-duel-bot",
	"version": "1.0.0",
	"description": "YuGiOh Duel Bot created for Fiverr user Zacbrowne.",
	"main": "dist/index.js",
	"repository": "https://github.com/Lioness100/ygo-duel-bot",
	"author": "Lioness100 <lioness.fiverr@gmail.com>",
	"type": "module",
	"private": true,
	"scripts": {
		"pm2": "pm2 start pm2.ecosystem.yml",
		"start": "node --enable-source-maps --experimental-specifier-resolution=node .",
		"register": "node --enable-source-maps dist/register.js",
		"lint": "eslint src --ext js,ts --fix",
		"format": "prettier --write \"src/**/*.[jt]s\"",
		"update": "yarn upgrade-interactive",
		"build": "tsup",
		"watch": "tsup --watch",
		"dev": "tsup --watch --onSuccess \"yarn start\"",
		"typecheck": "tsc -b src"
	},
	"dependencies": {
		"@discordjs/builders": "^0.13.0",
		"@discordjs/rest": "^0.4.1",
		"@sapphire/discord.js-utilities": "^4.10.0",
		"@sapphire/utilities": "^3.6.2",
		"canvas": "^2.9.1",
		"discord-api-types": "^0.32.0",
		"discord.js": "^13.6.0",
		"dotenv": "^16.0.0",
		"lowdb": "^3.0.0",
		"pretty-ms": "^7.0.1"
	},
	"optionalDependencies": {
		"bufferutil": "^4.0.6",
		"utf-8-validate": "^5.0.9",
		"zlib-sync": "^0.1.7"
	},
	"devDependencies": {
		"@sapphire/eslint-config": "^4.3.3",
		"@sapphire/prettier-config": "^1.4.2",
		"@sapphire/ts-config": "^3.3.4",
		"@swc/core": "^1.2.165",
		"@types/node": "^17.0.21",
		"@typescript-eslint/eslint-plugin": "^5.18.0",
		"@typescript-eslint/parser": "^5.18.0",
		"eslint": "^8.13.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-prettier": "^4.0.0",
		"eslint-plugin-unicorn": "^42.0.0",
		"pm2": "^5.2.0",
		"prettier": "^2.6.2",
		"tsup": "^5.12.4",
		"typescript": "^4.6.3"
	},
	"engines": {
		"node": ">=16.6",
		"npm": ">=7"
	},
	"prettier": "@sapphire/prettier-config",
	"packageManager": "yarn@3.2.0"
}
